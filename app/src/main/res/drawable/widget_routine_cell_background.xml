<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF103044" />
            <stroke android:width="1dp" android:color="#FF67DDF5" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF081826" />
            <stroke android:width="1dp" android:color="#FF174258" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>
